# Realtime server production host (bare hostname, without https://, port, or trailing slash)
# Example: vanish-xo.my-subdomain.workers.dev
NEXT_PUBLIC_REALTIME_HOST=vanish-xo.akhilsemwal55.workers.dev

# Public site URL (used for canonical URLs, Open Graph, sitemap, invite links)
# Example: https://vanishxo.online/
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Global Leaderboard (Upstash Redis)
# Provided automatically by Vercel Upstash integration or from console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Google Sign-In & Auth.js
AUTH_SECRET=your_auth_secret_here
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_URL=http://localhost:3000

