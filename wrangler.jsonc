{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vanish-xo",
  "main": "realtime/server.ts",
  "compatibility_date": "2024-07-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      },
      {
        "name": "Lobby",
        "class_name": "Lobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Main",
        "Lobby"
      ]
    }
  ]
}
